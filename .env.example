# ==============================================================================
# Enterprise HR AI Copilot - Environment Configuration Template
# ==============================================================================

# Groq High-Speed LLM API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Hugging Face Router Token for 1024-dim Embeddings (https://huggingface.co/settings/tokens)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_token_here
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# Pinecone Vector Database (https://app.pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key_here
index_name=ragbot
PINECONE_NAMESPACE=

# Tavily Real-Time Web Search API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Admin Authentication for Document Upload & Auto-Indexing
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Document Ingestion Settings
CHUNK_SIZE=700
CHUNK_OVERLAP=120
